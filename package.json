{
  "name": "dos-usb",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.mjs",
  "description": "A modern UI for playing DOS games from a USB stick",
  "author": "Webber Takken",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-husky.mjs && next dev",
    "build": "next build",
    "start": "next start",
    "electron-dev": "concurrently -k \"yarn dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-build": "yarn build && electron-builder",
    "electron-pack": "yarn build && electron-builder --dir",
    "electron-start": "electron .",
    "electron-build:win": "yarn build && electron-builder --win portable --x64",
    "icons": "node scripts/icons.mjs",
    "test": "node scripts/ensure-husky.mjs && vitest run",
    "scrape": "tsx scripts/scrape-catalogue.ts",
    "add-games": "tsx scripts/add-games.ts",
    "build-library": "tsx scripts/build-library.ts",
    "starter-pack": "tsx scripts/starter-pack/verify.ts",
    "ingest": "tsx scripts/ingest-source.ts",
    "ingest-references": "tsx scripts/ingest-references.ts",
    "export-source": "tsx scripts/export-source.ts",
    "make-stick": "tsx scripts/make-stick.ts",
    "e2e": "node scripts/e2e/verify.mjs",
    "e2e:packaged": "node scripts/e2e/verify.mjs --packaged dist/linux-unpacked/dos-usb",
    "e2e:first-run": "node scripts/e2e/first-run.mjs dist/linux-unpacked/dos-usb",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "yarn oxlint --report-unused-disable-directives",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "setup:hooks": "node scripts/ensure-husky.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "electron-is-dev": "^3.0.1",
    "jsdom": "^30.0.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3",
    "@types/yazl": "^3",
    "@typescript/native-preview": "^7.0.0-dev.20260505.1",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "@vitest/coverage-istanbul": "^4.0.0",
    "axe-core": "4.14.0",
    "cheerio": "^1.0.0",
    "concurrently": "^10.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "happy-dom": "^21.0.0",
    "husky": "9",
    "lint-staged": "^17.0.0",
    "next": "patch:next@npm%3A16.4.3#~/.yarn/patches/next-npm-16.4.3-b100b90213.patch",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.63.0",
    "playwright": "1.64.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "wait-on": "^7.2.0",
    "yazl": "^3.3.1",
    "zustand": "^5.0.3"
  },
  "build": {
    "appId": "com.dosusb.app",
    "productName": "DOS USB",
    "afterPack": "./scripts/build/electronFuses.mjs",
    "files": [
      "out/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "DOSGamesPortable.exe"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "icon": "build/icon.png"
    },
    "appImage": {
      "artifactName": "DOSGamesPortable.AppImage"
    }
  },
  "packageManager": "yarn@4.18.1",
  "dependenciesMeta": {
    "sharp": {
      "built": true
    }
  }
}
